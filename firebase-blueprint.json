{
  "entities": {
    "Category": {
      "title": "Category",
      "description": "A thematic category for organizing cultural and historical contents",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The unique ID of the category" },
        "name": { "type": "string", "description": "The visual name of the category" },
        "slug": { "type": "string", "description": "The URL-friendly slug" },
        "description": { "type": "string", "description": "A summary of what this category represents" },
        "parentId": { "type": "string", "description": "ID of parent category if sub-category" },
        "icon": { "type": "string", "description": "The name of a Lucide-react icon to render" },
        "displayOrder": { "type": "number", "description": "Display sort order" },
        "status": { "type": "string", "enum": ["Hiển thị", "Ẩn"] }
      },
      "required": ["id", "name", "slug", "displayOrder", "status"]
    },
    "Unit": {
      "title": "Unit",
      "description": "A Party organization unit or branch publishing contents on the portal",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The unique ID of the unit" },
        "name": { "type": "string", "description": "Visual name of the unit/branch" },
        "slug": { "type": "string", "description": "URL-friendly slug" },
        "type": { "type": "string", "enum": ["Chi bộ", "Đảng bộ", "Cơ quan hành chính", "Trường học", "Khu phố", "Lực lượng vũ trang", "Doanh nghiệp"] },
        "description": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "representative": { "type": "string" },
        "thumbnail": { "type": "string" },
        "displayOrder": { "type": "number" },
        "status": { "type": "string", "enum": ["Hiển thị", "Ẩn"] }
      },
      "required": ["id", "name", "slug", "type", "displayOrder", "status"]
    },
    "Content": {
      "title": "Content",
      "description": "A content article, documentary paper, image, video or audio material",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 500 },
        "slug": { "type": "string" },
        "contentType": { "type": "string", "enum": ["Bài viết", "PDF", "Video", "Âm thanh", "Hình ảnh"] },
        "categoryId": { "type": "string" },
        "unitId": { "type": "string" },
        "summary": { "type": "string", "maxLength": 1000 },
        "body": { "type": "string" },
        "thumbnail": { "type": "string" },
        "sourceName": { "type": "string" },
        "sourceUrl": { "type": "string" },
        "documentTitle": { "type": "string" },
        "publisher": { "type": "string" },
        "publicationYear": { "type": "number" },
        "verificationNote": { "type": "string" },
        "author": { "type": "string" },
        "editor": { "type": "string" },
        "reviewer": { "type": "string" },
        "keywords": { "type": "array" },
        "status": { "type": "string", "enum": ["Nháp", "Chờ duyệt", "Đã xuất bản", "Lưu trữ"] },
        "featured": { "type": "boolean" },
        "viewCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "slug", "contentType", "categoryId", "summary", "body", "status", "viewCount", "createdAt", "updatedAt"]
    },
    "MediaItem": {
      "title": "MediaItem",
      "description": "A uploaded media file stored or referenced in the system",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fileName": { "type": "string" },
        "fileType": { "type": "string" },
        "fileSize": { "type": "number" },
        "fileUrl": { "type": "string" },
        "uploadedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fileName", "fileType", "fileSize", "fileUrl", "uploadedBy", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "An action log of content or setting changes on the system",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userFullName": { "type": "string" },
        "action": { "type": "string" },
        "entityType": { "type": "string" },
        "entityId": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "userFullName", "action", "entityType", "entityId", "description", "createdAt"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "System-wide brand, contact, and customizable front-page settings",
      "type": "object",
      "properties": {
        "siteName": { "type": "string" },
        "subtitle": { "type": "string" },
        "logo": { "type": "string" },
        "favicon": { "type": "string" },
        "banner": { "type": "string" },
        "contactInfo": {
          "type": "object",
          "properties": {
            "address": { "type": "string" },
            "phone": { "type": "string" },
            "email": { "type": "string" },
            "workingHours": { "type": "string" }
          }
        },
        "footerText": { "type": "string" },
        "primaryColor": { "type": "string" },
        "fontSizeAdjustment": { "type": "number" },
        "heroTitle": { "type": "string" },
        "heroSubtitle": { "type": "string" },
        "welcomeTitle": { "type": "string" },
        "welcomeText": { "type": "string" }
      },
      "required": ["siteName", "subtitle", "logo", "contactInfo", "footerText"]
    },
    "TimelineEvent": {
      "title": "TimelineEvent",
      "description": "A historic chronological event of Uncle Ho's life or Vietnamese history",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "year": { "type": "number" },
        "period": { "type": "string", "enum": ["Quê hương và tuổi thơ", "Hành trình tìm đường cứu nước", "Hoạt động cách mạng", "Thành lập Đảng", "Cách mạng Tháng Tám", "Kháng chiến, kiến quốc", "Xây dựng đất nước", "Di sản tư tưởng, đạo đức, phong cách"] },
        "summary": { "type": "string" },
        "body": { "type": "string" },
        "location": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "thumbnail": { "type": "string" },
        "sourceName": { "type": "string" },
        "displayOrder": { "type": "number" },
        "status": { "type": "string", "enum": ["Hiển thị", "Ẩn"] }
      },
      "required": ["id", "title", "date", "year", "period", "summary", "body", "displayOrder", "status"]
    },
    "JourneyStop": {
      "title": "JourneyStop",
      "description": "An interactive checkpoint stop during President Ho Chi Minh's 30-year journey (1911-1941)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "time": { "type": "string" },
        "country": { "type": "string" },
        "continent": { "type": "string", "enum": ["Asia", "Europe", "Africa", "America"] },
        "age": { "type": "number" },
        "pseudonym": { "type": "string" },
        "activity": { "type": "string" },
        "coords": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          }
        },
        "latLng": { "type": "string" },
        "latLngCoords": { "type": "array" },
        "thumbnail": { "type": "string" },
        "quote": { "type": "string" },
        "sourceName": { "type": "string" },
        "keyWork": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "desc": { "type": "string" }
          }
        }
      },
      "required": ["id", "name", "time", "country", "continent", "age", "pseudonym", "activity", "coords", "latLng", "latLngCoords", "thumbnail", "sourceName"]
    },
    "HistoricalWork": {
      "title": "HistoricalWork",
      "description": "A classic revolutionary literary work authored by President Ho Chi Minh",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "publishYear": { "type": "string" },
        "summary": { "type": "string" },
        "content": { "type": "string" },
        "thumbnail": { "type": "string" },
        "pdfUrl": { "type": "string" },
        "readOnlineUrl": { "type": "string" },
        "displayOrder": { "type": "number" },
        "status": { "type": "string", "enum": ["Hiển thị", "Ẩn"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "slug", "publishYear", "summary", "content", "thumbnail", "displayOrder", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "categories/{categoryId}": {
      "schema": "Category",
      "description": "Collection of thematic categories"
    },
    "units/{unitId}": {
      "schema": "Unit",
      "description": "Collection of Party units"
    },
    "contents/{contentId}": {
      "schema": "Content",
      "description": "Collection of articles and historical artifacts"
    },
    "mediaLibrary/{mediaId}": {
      "schema": "MediaItem",
      "description": "Collection of media assets"
    },
    "auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Collection of audit operations"
    },
    "settings/site": {
      "schema": "SiteSettings",
      "description": "The unique document for global site configuration"
    },
    "timelineEvents/{eventId}": {
      "schema": "TimelineEvent",
      "description": "Chronological events list of Uncle Ho"
    },
    "journeyStops/{stopId}": {
      "schema": "JourneyStop",
      "description": "Interactive stops on Uncle Ho's 30-year journey"
    },
    "historicalWorks/{workId}": {
      "schema": "HistoricalWork",
      "description": "Classic outstanding works written by President Ho Chi Minh"
    }
  }
}
