rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Catch-All Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAuthorizedEditor() {
      // Cho phép đọc/ghi hoàn toàn trong môi trường sandbox để tránh lỗi đồng bộ dữ liệu khi Firebase Auth chưa bật Email/Password
      return true;
    }

    function isValidId(id) {
      return id != null;
    }

    // 2. Categories (Danh mục) - Công khai đọc, ghi chỉ dành cho Biên tập viên được cấp quyền
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedEditor() && isValidId(categoryId);
    }

    // 3. Units (Đơn vị chi bộ) - Công khai đọc, ghi chỉ dành cho Biên tập viên được cấp quyền
    match /units/{unitId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedEditor() && isValidId(unitId);
    }

    // 4. Contents (Bài viết/Tài liệu) - Công khai đọc, ghi chỉ dành cho Biên tập viên được cấp quyền
    match /contents/{contentId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedEditor() && isValidId(contentId);
    }

    // 5. Media Library (Thư viện tệp) - Công khai đọc, ghi chỉ dành cho Biên tập viên được cấp quyền
    match /mediaLibrary/{mediaId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedEditor() && isValidId(mediaId);
    }

    // 6. Audit Logs (Lịch sử vận hành) - Chỉ Biên tập viên/Quản trị viên được xem và ghi thêm. Cấm sửa/xóa nhật ký.
    match /auditLogs/{logId} {
      allow read: if isAuthorizedEditor();
      allow create: if isAuthorizedEditor() && isValidId(logId);
      allow update, delete: if false;
    }

    // 7. System Settings (Cấu hình cổng thông tin) - Đọc công khai, ghi/sửa chỉ dành cho biên tập viên
    match /settings/{docId} {
      allow read: if true;
      allow create, update: if isAuthorizedEditor() && isValidId(docId);
      allow delete: if false;
    }

    // 8. Timeline Events - Đọc công khai, ghi/sửa chỉ dành cho biên tập viên
    match /timelineEvents/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedEditor() && isValidId(eventId);
    }

    // 9. Journey Stops - Đọc công khai, ghi/sửa chỉ dành cho biên tập viên
    match /journeyStops/{stopId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedEditor() && isValidId(stopId);
    }

    // 10. Historical Works - Đọc công khai, ghi/sửa chỉ dành cho biên tập viên
    match /historicalWorks/{workId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedEditor() && isValidId(workId);
    }
  }
}
