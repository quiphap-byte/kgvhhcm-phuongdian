rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Catch-All Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAuthorizedEditor() {
      return isSignedIn() && (
        request.auth.uid == 'usr-admin' ||
        ('email' in request.auth.token && (
          request.auth.token.email == 'quiphap@gmail.com' ||
          request.auth.token.email == 'minhquang@dian.gov.vn' ||
          request.auth.token.email == 'kimthanh@dian.gov.vn' ||
          request.auth.token.email == 'admin@dian.gov.vn'
        ))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // 2. Categories (Danh mục) - Công khai đọc, ghi chỉ dành cho Biên tập viên được cấp quyền
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedEditor() && isValidId(categoryId);
    }

    // 3. Units (Đơn vị chi bộ) - Công khai đọc, ghi chỉ dành cho Biên tập viên được cấp quyền
    match /units/{unitId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedEditor() && isValidId(unitId);
    }

    // 4. Contents (Bài viết/Tài liệu) - Công khai đọc, ghi chỉ dành cho Biên tập viên được cấp quyền
    match /contents/{contentId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedEditor() && isValidId(contentId);
    }

    // 5. Media Library (Thư viện tệp) - Công khai đọc, ghi chỉ dành cho Biên tập viên được cấp quyền
    match /mediaLibrary/{mediaId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedEditor() && isValidId(mediaId);
    }

    // 6. Audit Logs (Lịch sử vận hành) - Chỉ Biên tập viên/Quản trị viên được xem và ghi thêm. Cấm sửa/xóa nhật ký.
    match /auditLogs/{logId} {
      allow read: if isAuthorizedEditor();
      allow create: if isAuthorizedEditor() && isValidId(logId);
      allow update, delete: if false;
    }

    // 7. System Settings (Cấu hình cổng thông tin) - Đọc công khai, ghi/sửa chỉ dành cho biên tập viên
    match /settings/{docId} {
      allow read: if true;
      allow create, update: if isAuthorizedEditor() && isValidId(docId);
      allow delete: if false;
    }
  }
}
